{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // ConnectionStrings:Default 與 Jwt:SigningKey 走 dotnet user-secrets，不進版控（見 README）
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": { "Issuer": "KnowledgeHub", "Audience": "KnowledgeHub" },
  // Entra ID（公司 M365 租戶）設定：TenantId／ClientId／GroupDepartmentMap 含真實租戶與
  // 群組 Object ID，一律放 appsettings.Local.json 或 user-secrets（見 README），這裡只留
  // 空白佔位結構。GroupDepartmentMap：key=群組 Object ID、value=部門代碼；宣告順序＝比對
  // 優先序（使用者屬於多個已映射群組時取第一個命中）。
  "Entra": { "TenantId": "", "ClientId": "", "GroupDepartmentMap": {} },
  // AI provider 為 Vertex AI（服務帳戶 OAuth，見 Vertex:SaKeyPath in user-secrets）。
  // ProjectId/Location 非機密，直接進版控；ChatModel 用 Vertex 命名（含 google/ 前綴）。
  "Vertex": { "ProjectId": "luxiaomie", "Location": "global" },
  "Gemini": { "ChatModel": "google/gemini-2.5-flash" },
  "SeedUsers": [
    { "Username": "hr-user",  "Password": "demo-hr-2026",  "Department": "HR" },
    { "Username": "it-user",  "Password": "demo-it-2026",  "Department": "IT" },
    { "Username": "fin-user", "Password": "demo-fin-2026", "Department": "Finance" }
  ]
}
