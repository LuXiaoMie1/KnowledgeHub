{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // ConnectionStrings:Default 與 Jwt:SigningKey 走 dotnet user-secrets，不進版控（見 README）
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": { "Issuer": "KnowledgeHub", "Audience": "KnowledgeHub" },
  // Entra ID（公司 M365 租戶）設定：TenantId／ClientId／GroupDepartmentMap 含真實租戶與
  // 群組 Object ID，一律放 appsettings.Local.json 或 user-secrets（見 README），這裡只留
  // 空白佔位結構。GroupDepartmentMap：key=群組 Object ID、value=部門代碼；使用者屬於多個
  // 已映射群組時，全部部門都會加上 department claim（多部門聯集檢索，見 EntraGroupDepartmentMapper）。
  "Entra": { "TenantId": "", "ClientId": "", "GroupDepartmentMap": {} },
  // Bot Framework（/api/messages，見 Program.cs）設定：MicrosoftAppId 留空時
  // ConfigurationBotFrameworkAuthentication 走匿名認證，本機用 Bot Framework Emulator
  // 連線不需要填。之後串 Teams／Azure Bot Service 才需要從 user-secrets 帶入正式值
  // （MicrosoftAppType 通常是 "MultiTenant" 或 "SingleTenant"）。
  "Bot": { "MicrosoftAppType": "", "MicrosoftAppId": "", "MicrosoftAppPassword": "", "MicrosoftAppTenantId": "" },
  // AI provider 為 Vertex AI（服務帳戶 OAuth，見 Vertex:SaKeyPath in user-secrets）。
  // ProjectId/Location 非機密，直接進版控；ChatModel 用 Vertex 命名（含 google/ 前綴）。
  "Vertex": { "ProjectId": "luxiaomie", "Location": "global" },
  "Gemini": { "ChatModel": "google/gemini-2.5-flash" },
  // SeedUsers（本機測試帳號）走 dotnet user-secrets，不進版控（見 README）：
  //   dotnet user-secrets set "SeedUsers:0:Username" "..." 等，索引 0..N 依序設 Username/Password/Department
  "SeedUsers": []
}
